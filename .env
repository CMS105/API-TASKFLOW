# PostgreSQL Connection Details
# Replace 'your_postgres_password' with the password you set during PostgreSQL installation
DB_USER=postgres
DB_PASSWORD=student123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fastapi_db

# Fallback: if true and PostgreSQL password is not yet configured,
# the app will smoothly start in SQLite mode so you can preview everything immediately.
USE_SQLITE_FALLBACK=true
